DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_DISPLAY_NAME=DeepSeek-V4.1-Flash-1017
PORT=3000
HOST=127.0.0.1

# 填写DEEPSEEK_API_KEY后，运行 npm run configure-browser
# 可生成仅供队内测试的双击直开配置 config.local.js

# 默认仅在服务进程内缓存 30 分钟。仅在需要跨重启保存报告时启用磁盘缓存。
# CACHE_PERSIST=1
# CACHE_TTL_DAYS=30

# 可选：设置 v1.3 启用对照或回退。默认使用 v1.4。
# SCORING_STRATEGY=v1.3
